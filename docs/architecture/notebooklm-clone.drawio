        </mxCell>
        <mxCell id="source" value="&lt;b&gt;source&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id: uuid; FK notebook_id: uuid&lt;br&gt;status: source_state; version: int&lt;br&gt;storage_key: text?; title: text?&lt;br&gt;mime: text; bytes: bigint&lt;br&gt;error_code: text?; deleted_at: time?&lt;br&gt;UNIQUE(notebook_id, id)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="220" width="360" height="215" />
        </mxCell>
        <mxCell id="chunk" value="&lt;b&gt;chunk&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id: uuid; FK source_id: uuid&lt;br&gt;notebook_id: uuid; ordinal: int&lt;br&gt;text: text; tokens: int&lt;br&gt;page_no: int?; char_start/end: int&lt;br&gt;UNIQUE(source_id, ordinal)&lt;br&gt;UNIQUE(notebook_id, source_id, id)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1370" y="220" width="380" height="215" />
        </mxCell>
        <mxCell id="quota" value="&lt;b&gt;quota_bucket&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK(scope_type, scope_key, window)&lt;br&gt;reserved_tokens: bigint&lt;br&gt;used_tokens: bigint; requests: int&lt;br&gt;Atomic reserve before provider call&lt;br&gt;Session + service-wide daily buckets" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="540" width="310" height="200" />
        </mxCell>
        <mxCell id="operation" value="&lt;b&gt;operation&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id: uuid; FK notebook_id: uuid&lt;br&gt;kind: ingest | answer | summary&lt;br&gt;state: running | succeeded | failed&lt;br&gt;idempotency_key, request_hash: text&lt;br&gt;lease_until: time; attempt: int&lt;br&gt;model, prompt_version: text?&lt;br&gt;usage: jsonb; error_code: text?&lt;br&gt;UNIQUE(notebook_id, kind, idem_key)&lt;br&gt;UNIQUE(notebook_id, id)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="505" width="330" height="285" />
        </mxCell>
        <mxCell id="selection" value="&lt;b&gt;operation_source&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK(operation_id, source_id)&lt;br&gt;FK notebook_id, operation_id&lt;br&gt;FK notebook_id, source_id&lt;br&gt;source_version: int&lt;br&gt;Input-selection snapshot&lt;br&gt;One source for ingestion operations" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="535" width="360" height="205" />
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id: uuid; notebook_id: uuid&lt;br&gt;FK operation_id, source_id, chunk_id&lt;br&gt;ordinal: int; unavailable_at: time?&lt;br&gt;Immutable membership, no copied text&lt;br&gt;chunk_id NULL after source purge&lt;br&gt;UNIQUE(notebook_id, operation_id, id)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1370" y="535" width="380" height="205" />
        </mxCell>
        <mxCell id="entry" value="&lt;b&gt;entry&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id: uuid; FK notebook_id: uuid&lt;br&gt;FK operation_id: uuid?; parent_id: uuid?&lt;br&gt;kind: question | answer | summary | note&lt;br&gt;body: jsonb?; unavailable_at: time?&lt;br&gt;UNIQUE(notebook_id, operation_id, id)&lt;br&gt;UNIQUE(notebook_id, id)&lt;br&gt;One chat thread per notebook" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="875" width="330" height="235" />
        </mxCell>
        <mxCell id="citation" value="&lt;b&gt;citation&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK(entry_id, block_no, ordinal)&lt;br&gt;FK notebook_id, operation_id, entry_id&lt;br&gt;FK notebook_id, operation_id, evidence_id&lt;br&gt;No model-provided quote / page stored&lt;br&gt;Quote and location resolved on read" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
