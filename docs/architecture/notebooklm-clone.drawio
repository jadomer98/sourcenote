        <mxCell id="title" value="04  Question-to-citation sequence" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=30;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="65" width="1520" height="48" />
        </mxCell>
        <mxCell id="subtitle" value="Answer, limitation and provider failure are separate outcomes. No unchecked model text reaches the browser." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
