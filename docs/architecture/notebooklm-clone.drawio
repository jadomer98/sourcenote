        </mxCell>
        <mxCell id="e9" value="1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#059669;fontFamily=Helvetica;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="operation" target="entry">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e10" value="1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#059669;fontFamily=Helvetica;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="entry" target="citation">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e11" value="1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#059669;fontFamily=Helvetica;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="evidence" target="citation">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1560" y="815" />
              <mxPoint x="1315" y="815" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="qnote" value="&lt;b&gt;Quota is a service guard&lt;/b&gt;&lt;br&gt;&lt;br&gt;No direct owner FK for global/IP buckets.&lt;br&gt;Scope keys are opaque or HMAC-hashed.&lt;br&gt;Short-lived counters; no source text.&lt;br&gt;Hard global cap limits cookie-reset abuse." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="875" width="310" height="200" />
        </mxCell>
        <mxCell id="constraints" value="&lt;b&gt;Integrity &amp;amp; indexes&lt;/b&gt;&lt;br&gt;&lt;br&gt;All notebook-scoped FKs include notebook_id. Citation FKs also include operation_id: another operation’s evidence cannot be attached.&lt;br&gt;Evidence references operation_source + matching chunk source. Entry parent FK includes notebook_id; note-copy logic preserves operation provenance.&lt;br&gt;Index: notebook(owner_id, created_at); source(notebook_id, status); chunk(source_id, ordinal); entry(notebook_id, created_at); operation(state, lease_until).&lt;br&gt;CHECK: positive sizes / valid locations; enum states; nullable fields shown with ?. SQL details and deletion order: schema-notes.md." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1170" width="1710" height="165" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
