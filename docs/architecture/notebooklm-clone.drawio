        </mxCell>
        <mxCell id="subtitle" value="One deployable application. Durable private data. One explicit boundary where selected evidence leaves the application." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
