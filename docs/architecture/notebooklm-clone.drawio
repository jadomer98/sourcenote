        <mxCell id="notebook" value="&lt;b&gt;notebook&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id: uuid&lt;br&gt;FK owner_id: uuid&lt;br&gt;title: text; created_at: timestamptz&lt;br&gt;UNIQUE(owner_id, id)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
