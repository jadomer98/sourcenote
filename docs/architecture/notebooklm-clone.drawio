        <mxCell id="footer" value="ARCH-03  /  Proposed design, not implemented  /  2026-10-23  /  MVP-01–11  /  See manifest and ADRs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1388" width="1720" height="25" />
        </mxCell>
        <mxCell id="owner" value="&lt;b&gt;workspace_owner&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id: uuid&lt;br&gt;token_hash: bytea UNIQUE&lt;br&gt;created_at, expires_at: timestamptz" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
