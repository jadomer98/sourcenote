        <mxCell id="life0" value="" style="html=1;endArrow=none;endFill=1;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=13;fontColor=#334155;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="160" y="255" />
            <mxPoint as="targetPoint" x="160" y="1450" />
