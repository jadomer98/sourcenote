{
  "name": "sourcenote",
  "version": "1.0.0",
  "private": true,
  "description": "A source-grounded research workspace inspired by NotebookLM",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "evaluate": "tsx scripts/evaluate.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@next/env": "^16.4.3",
    "@vercel/functions": "^3.10.3",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
