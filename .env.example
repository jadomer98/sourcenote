# Copy to .env.local. Never commit actual credentials.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Alternative: AI_PROVIDER=cloudflare and AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: unset for durable local PGlite; required on hosted production.
DATABASE_URL=
DATA_DIR=.data
# Required on public deployments; exact HTTPS origin without trailing slash.
APP_ORIGIN=http://localhost:3000
# Generate a random value (at least 32 characters) for production.
SESSION_SECRET=change-this-to-a-long-random-secret
GLOBAL_DAILY_TOKEN_LIMIT=100000
GLOBAL_STORAGE_BYTES=52428800
SESSION_DAILY_REQUESTS=30
# Test-only; rejected in production. Do not enable for a real demo.
AI_TEST_MODE=false
